# Copy to .env (gitignored) and fill in:  cp .env.example .env

# HF_TOKEN — HuggingFace token (role: Read), only for speaker diarization.
# Accept the licences for all three gated repos (each 403s if missing; 4.x loads
# community-1 weights even when pinned to 3.1), then make a token:
#   https://huggingface.co/pyannote/speaker-diarization-community-1
#   https://huggingface.co/pyannote/speaker-diarization-3.1
#   https://huggingface.co/pyannote/segmentation-3.0
#   https://huggingface.co/settings/tokens
# Leave blank to skip diarization; the rest of the pipeline runs fully local.
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
